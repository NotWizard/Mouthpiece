<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>zh_CN</string>
  <key>CFBundleDisplayName</key>
  <string>Mouthpiece</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleIconFile</key>
  <string>Mouthpiece</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.mouthpiece.app.oauth</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>mouthpiece</string>
      </array>
    </dict>
  </array>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <key>LSMinimumSystemVersion</key>
  <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
  <key>NSAccessibilityUsageDescription</key>
  <string>Mouthpiece needs Accessibility access to insert transcribed text into other applications.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Mouthpiece needs microphone access for speech-to-text transcription.</string>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
  <key>SUFeedURL</key>
  <!-- Fallback only: ArchitectureUpdateFeedDelegate overrides this per architecture at runtime. -->
  <string>https://github.com/NotWizard/Mouthpiece/releases/latest/download/appcast-arm64.xml</string>
  <key>SUPublicEDKey</key>
  <string>$(SPARKLE_PUBLIC_ED_KEY)</string>
</dict>
</plist>
